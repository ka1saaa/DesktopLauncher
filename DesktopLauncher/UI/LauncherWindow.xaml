<Window x:Class="DesktopLauncher.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面启动器"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">

    <Grid x:Name="RootGrid" MouseLeftButtonDown="OnRootMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 背景：壁纸（模糊预渲染位图，代码赋值）+ 暗化遮罩 -->
        <Grid Grid.RowSpan="2">
            <Image x:Name="WallpaperImage" Stretch="UniformToFill"/>
            <Border x:Name="BackgroundShade">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C8161B26" Offset="0"/>
                        <GradientStop Color="#D2151922" Offset="0.5"/>
                        <GradientStop Color="#E012161F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- 顶栏 -->
        <DockPanel Grid.Row="0" Margin="56,44,56,0">
            <Border Width="380" Height="42" CornerRadius="21" Background="#2EF2F4F8" DockPanel.Dock="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="15" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.75"
                               FontFamily="Segoe UI Emoji, Microsoft YaHei UI"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center"
                             Background="Transparent" BorderThickness="0" Foreground="#F2F4F8" FontSize="14" CaretBrush="#F2F4F8"
                             TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown"
                             VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="SearchHint" Text="搜索应用…" Margin="38,0,16,0" VerticalAlignment="Center"
                               Foreground="#99F2F4F8" FontSize="14" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="EditButton" Content="✏ 编辑" Style="{StaticResource TopButton}" Margin="0,0,10,0" Click="OnToggleEdit"/>
                <Button Content="⚙ 设置" Style="{StaticResource TopButton}" Margin="0,0,10,0" Click="OnSettingsClick"/>
                <Button x:Name="CloseButton" Content="×" Style="{StaticResource TopButton}" Width="38" Padding="0" Click="OnCloseClick"/>
            </StackPanel>
        </DockPanel>

        <!-- 主区：文件夹宫格 / 搜索结果 -->
        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MainStack" Margin="56,32,56,48" HorizontalAlignment="Center">
                <WrapPanel x:Name="FoldersPanel" HorizontalAlignment="Center"/>
                <WrapPanel x:Name="SearchResultsPanel" Visibility="Collapsed" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyHint" Text="还没有分类，点击右上角「编辑」开始整理吧" Foreground="#B8BFCC"
                           FontSize="15" HorizontalAlignment="Center" Margin="0,48,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 文件夹展开浮层 -->
        <Border x:Name="PopupOverlay" Grid.RowSpan="2" Background="#59000000" Visibility="Collapsed"
                MouseLeftButtonDown="OnPopupOverlayMouseDown">
            <Border x:Name="PopupPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="1000" MaxHeight="660" Margin="60" CornerRadius="22"
                    Background="{StaticResource PanelBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
                <Grid Margin="30,24,30,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PopupTitle" Text="文件夹" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PopupCount" Text="" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                                       VerticalAlignment="Center" Margin="12,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PopupSelectButton" Content="☐ 选择" Style="{StaticResource TopButton}" Margin="0,0,8,0" Click="OnToggleSelectMode"/>
                            <Button x:Name="PopupRenameButton" Content="✎ 重命名" Style="{StaticResource TopButton}" Margin="0,0,8,0" Click="OnPopupRename" Visibility="Collapsed"/>
                            <Button x:Name="PopupAddButton" Content="+ 添加应用" Style="{StaticResource TopButton}" Margin="0,0,8,0" Click="OnPopupAddApp" Visibility="Collapsed"/>
                            <Button x:Name="PopupDeleteButton" Content="🗑 删除" Style="{StaticResource TopButton}" Margin="0,0,8,0" Click="OnPopupDelete" Visibility="Collapsed"/>
                            <Button Content="×" Style="{StaticResource TopButton}" Width="34" Padding="0" Click="OnPopupClose"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="PopupAppsPanel"/>
                    </ScrollViewer>

                    <!-- 编辑模式批量操作条 -->
                    <Border x:Name="BatchBar" Grid.Row="2" Visibility="Collapsed" Margin="0,14,0,0"
                            CornerRadius="12" Background="#402A3040" Padding="16,8">
                        <DockPanel>
                            <TextBlock x:Name="BatchCount" Text="已选 0 项" Foreground="{StaticResource AccentBrush}"
                                       FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="移动到…" Style="{StaticResource TopButton}" Margin="0,0,8,0" Click="OnBatchMove"/>
                                <Button x:Name="BatchRemoveButton" Content="移除所选" Style="{StaticResource TopButton}" Margin="0,0,8,0" Click="OnBatchRemove"/>
                                <Button Content="取消选择" Style="{StaticResource TopButton}" Click="OnBatchClear"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- 底部提示 -->
        <Border x:Name="Toast" Grid.RowSpan="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,56" CornerRadius="18" Background="#CC1E2432" Padding="20,10">
            <TextBlock x:Name="ToastText" Text="" Foreground="#F2F4F8" FontSize="13"/>
        </Border>
    </Grid>
</Window>
