<Window x:Class="DesktopLauncher.UI.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面启动器" Width="380" SizeToContent="Height"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner" Topmost="True"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="#1E2432">
    <StackPanel Margin="20">
        <TextBlock x:Name="Prompt" Text="" Foreground="#F2F4F8" FontSize="14" Margin="0,0,0,10"/>
        <TextBox x:Name="Input" Height="34" FontSize="14" Padding="6,4"
                 Foreground="#F2F4F8" Background="#2A3040" BorderBrush="#3A4254" BorderThickness="1"
                 CaretBrush="#F2F4F8" VerticalContentAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="76" Height="32" Margin="0,0,10,0" Click="OnCancel" Background="#2A3040" Foreground="#F2F4F8" BorderThickness="0"/>
            <Button Content="确定" Width="76" Height="32" Click="OnOk" Background="#5B8CFF" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
