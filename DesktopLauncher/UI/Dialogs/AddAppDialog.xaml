<Window x:Class="DesktopLauncher.UI.Dialogs.AddAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加应用" Width="580" Height="640"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen" Topmost="True"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="#1E2432">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="勾选要加入的桌面应用（可多选），或点击「浏览…」添加任意程序（不会移动原文件）"
                   Foreground="#B8BFCC" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" Height="34" FontSize="13" Padding="8,4"
                     Foreground="#F2F4F8" Background="#2A3040" BorderBrush="#3A4254" BorderThickness="1"
                     CaretBrush="#F2F4F8" VerticalContentAlignment="Center"
                     TextChanged="OnFilterChanged"/>
            <Button Grid.Column="1" Content="浏览…" Width="86" Height="34" Margin="10,0,0,0"
                    Click="OnBrowse" Background="#2A3040" Foreground="#F2F4F8" BorderThickness="0"/>
        </Grid>

        <Border Grid.Row="2" Background="#222838" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListPanel" Margin="6"/>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="CountText" Text="已选 0 项" Foreground="#5B8CFF" FontSize="13"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="76" Height="32" Margin="0,0,10,0" Click="OnCancel" Background="#2A3040" Foreground="#F2F4F8" BorderThickness="0"/>
                <Button x:Name="OkButton" Content="添加所选" Width="96" Height="32" Click="OnOk" Background="#5B8CFF" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
