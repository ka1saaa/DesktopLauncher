<Window x:Class="DesktopLauncher.UI.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="580" MinHeight="560" SizeToContent="Height" MaxHeight="980"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner" Topmost="True"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="#1E2432">

    <Window.Resources>
        <!-- 深色 ComboBox：系统默认模板的显示区不响应 Background（浅色底+浅色字看不清），整体换深色模板 -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Background" Value="#2A3040"/>
            <Setter Property="BorderBrush" Value="#3A4254"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <Path Data="M0,0 L4,4 8,0" Stroke="#B8BFCC" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3A4560"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#222838" CornerRadius="6" BorderBrush="#3A4254" BorderThickness="1"
                                        Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="4">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色下拉项 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Background" Value="#222838"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A4254"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#32405F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 全局热键 -->
        <TextBlock Grid.Row="0" Text="全局热键" Foreground="#F2F4F8" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <ComboBox x:Name="ModifierBox" Width="150" Height="34" Background="#2A3040" Foreground="#F2F4F8" FontSize="13"/>
            <TextBlock Text="＋" Foreground="#B8BFCC" VerticalAlignment="Center" Margin="10,0" FontSize="14"/>
            <ComboBox x:Name="KeyBox" Width="100" Height="34" Background="#2A3040" Foreground="#F2F4F8" FontSize="13"/>
            <Button Content="应用" Width="76" Height="34" Margin="14,0,0,0" Click="OnApplyHotkey"
                    Background="#5B8CFF" Foreground="White" BorderThickness="0" FontSize="13"/>
        </StackPanel>
        <TextBlock x:Name="HotkeyHint" Grid.Row="2" Text="按热键可随时打开/收起启动器" Foreground="#6E7789" FontSize="12" Margin="0,0,0,18"/>

        <!-- 行为开关 -->
        <StackPanel Grid.Row="3" Margin="0,0,0,18">
            <TextBlock Text="行为" Foreground="#F2F4F8" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <CheckBox x:Name="AutoStartBox" Content="开机自动启动" Foreground="#F2F4F8" FontSize="13" Margin="0,5"/>
            <CheckBox x:Name="BallVisibleBox" Content="显示桌面悬浮球" Foreground="#F2F4F8" FontSize="13" Margin="0,9,0,0"/>
            <CheckBox x:Name="CloseOnLaunchBox" Content="启动应用后自动关闭启动器" Foreground="#F2F4F8" FontSize="13" Margin="0,9,0,0"/>
            <CheckBox x:Name="HideIconsBox" Content="隐藏桌面应用图标（应用进启动器，桌面更整洁）" Foreground="#F2F4F8" FontSize="13" Margin="0,9,0,0"/>
            <TextBlock x:Name="HideIconsHint" Text="只隐藏快捷方式/程序，文件夹与压缩包不受影响。隐藏期间会临时把资源管理器切为「不显示隐藏的文件」，恢复图标时自动还原"
                       Foreground="#6E7789" FontSize="11" Margin="22,5,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="HideIconsResult" Text="" Foreground="#5B8CFF" FontSize="12" Margin="22,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 文件夹快捷键 -->
        <StackPanel Grid.Row="4" Margin="0,0,0,18">
            <TextBlock Text="文件夹快捷键" Foreground="#F2F4F8" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="按下即在资源管理器打开对应文件夹，可添加多条" Foreground="#6E7789" FontSize="11" Margin="0,0,0,8"/>
            <StackPanel x:Name="FolderHotkeyList"/>
            <Button Content="+ 添加文件夹快捷键" Width="150" Height="30" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Click="OnAddFolderHotkey" Background="#2A3040" Foreground="#F2F4F8" BorderThickness="0" FontSize="12"/>
            <TextBlock x:Name="FolderHotkeyResult" Foreground="#FF7A7A" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 额外扫描目录 -->
        <StackPanel Grid.Row="5" Margin="0,0,0,4">
            <TextBlock Text="额外扫描目录" Foreground="#F2F4F8" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="桌面已搬迁到其他位置、或想把下载目录等也列入「添加应用」候选时添加"
                       Foreground="#6E7789" FontSize="11" Margin="0,0,0,8"/>
            <ListBox x:Name="DirsList" Background="#222838" BorderThickness="0" MinHeight="60" MaxHeight="110" FontSize="12"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="+ 添加目录" Width="100" Height="30" Click="OnAddDir" Background="#2A3040" Foreground="#F2F4F8" BorderThickness="0" FontSize="12"/>
                <Button Content="－ 移除所选" Width="100" Height="30" Margin="10,0,0,0" Click="OnRemoveDir" Background="#2A3040" Foreground="#F2F4F8" BorderThickness="0" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="6" Content="完成" Width="96" Height="36" HorizontalAlignment="Right" Margin="0,20,0,0"
                Click="OnDone" Background="#5B8CFF" Foreground="White" BorderThickness="0" FontSize="13"/>
    </Grid>
</Window>
