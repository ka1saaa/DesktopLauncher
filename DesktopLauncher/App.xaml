<Application x:Class="DesktopLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DesktopLauncher"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <local:IconConverter x:Key="IconConverter"/>

        <!-- 深色玻璃风格公共资源 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#E21E2432"/>
        <SolidColorBrush x:Key="TileBrush" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="TileHoverBrush" Color="#55FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F4F8"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#B8BFCC"/>

        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#28FFFFFF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <!-- emoji + 中文混合内容的字体回退 -->
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Microsoft YaHei UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#46FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
